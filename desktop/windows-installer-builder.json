{
  "appId": "com.ateliedearte.desktop",
  "productName": "Ateliê de Arte",
  "electronVersion": "44.9.1",
  "npmRebuild": false,
  "compression": "normal",
  "directories": { "output": "release" },
  "win": {
    "executableName": "Atelie-de-Arte",
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "signAndEditExecutable": false
  },
  "nsis": {
    "artifactName": "Atelie-de-Arte-Instalador-Windows-x64.exe",
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Ateliê de Arte",
    "deleteAppDataOnUninstall": false,
    "useZip": true,
    "differentialPackage": false
  }
}
